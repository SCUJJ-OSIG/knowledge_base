filters:
  and:
    - file.ext == "md"
properties:
  形态:
    displayName: 形态
  场景:
    displayName: 场景
  tags:
    displayName: tags
  file.mtime:
    displayName: 修改时间
views:
  - type: table
    name: 全部已发布
    order:
      - file.name
      - 形态
      - 场景
      - tags
      - file.mtime
      - published
    sort:
      - property: published
        direction: DESC
    slug: all
  - type: table
    name: 视图
